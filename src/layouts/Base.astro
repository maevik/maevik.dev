---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

let { title, description, frontmatter } = Astro.props;
title = title || frontmatter?.title;
description = description || frontmatter?.description || "maevik's personal website";
const siteTitle = title ? `maevik.dev | ${title}` : "maevik.dev";
const url = Astro.url;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{siteTitle}</title>
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:image" content="/favicon.png" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={description} />
        <ClientRouter />
        <!-- https://github.com/withastro/astro/issues/15470 -->
        <script>
            document.addEventListener('astro:before-swap', (e) => {
                e.newDocument.querySelector('script[src*="/cloudflare-static/email-decode"]')?.setAttribute('data-astro-rerun', '');
            });
        </script>
	</head>
	<body 
		class="dot-matrix bg-stone-50 text-stone-800 min-h-screen flex flex-col"
		transition:persist
	>
		<Header />
		<div class="sticky top-0 z-10 bg-stone-50/90 px-6 py-5 backdrop-blur-sm sm:px-8">
			<div class="mx-auto max-w-[65ch]">
				<nav class="flex gap-4">
					<a href="/blog">blog</a>
					<a href="/project">project</a>
				</nav>

				<hr class="mt-5 border-stone-900 opacity-20" />
			</div>
		</div>
			<main class="flex-1 flex items-center justify-center text-center" transition:animate="fade">
				<div class="w-full max-w-[65ch]">
				<slot />
				</div>
			</main>
		<Footer />
	</body>
</html>
