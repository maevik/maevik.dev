---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

const { title = "maevik.dev" } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <ClientRouter />
        <!-- https://github.com/withastro/astro/issues/15470 -->
        <script>
            document.addEventListener('astro:before-swap', (e) => {
                e.newDocument.querySelector('script[src*="/cloudflare-static/email-decode"]')?.setAttribute('data-astro-rerun', '');
            });
        </script>
	</head>
	<body 
		class="dot-matrix bg-amber-50 text-stone-900 min-h-screen flex flex-col"
		transition:persist
	>
		<Header />
			<main class="flex-1 w-full flex items-center justify-center text-center" transition:animate="fade">
				<slot />
			</main>
		<Footer />
	</body>
</html>
