---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base>
  <div class="w-full max-w-sm text-left">
    <h1 class="text-3xl md:text-4xl font-bold mb-8">Blog</h1>
    {posts.length > 0 ? (
      <ul class="space-y-4">
        {posts.map((post, i) => (
          <li class="flex justify-between">
            <span>
              <span class="opacity-50">{i + 1}.</span>
              <a href={`/blog/${post.id}`} class="ml-2 text-sky-900 hover:underline">
                {post.data.title}
              </a>
            </span>
            <span class="opacity-50 shrink-0">
              {post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="opacity-50">No posts yet.</p>
    )}
  </div>
</Base>
