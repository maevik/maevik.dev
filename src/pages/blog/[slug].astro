---
import Base from "../../layouts/Base.astro";
import Markdown from "../../layouts/Markdown.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const post = await getEntry("blog", slug);
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <Markdown>
    <article>
      <h1>{post.data.title}</h1>
      {post.data.description && (
        <p class="opacity-50 -mt-3">{post.data.description}</p>
      )}
      <div class="flex flex-wrap gap-1.5 mb-4">
        <div class="text-sm text-stone-500 bg-stone-100 rounded-lg px-2 py-0.5">
          <span class="text-stone-400">date: </span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.getFullYear()}{" "}
            {post.data.pubDate.toLocaleDateString("en-US", { month: "short" })}{" "}
            {post.data.pubDate.getDate()}
          </time>
        </div>
        {post.data.tags && (
          <div class="text-sm text-stone-500 bg-stone-100 rounded-lg px-2 py-0.5">
            <span class="text-stone-400">tags: </span>
            <span>{post.data.tags.join(", ")}</span>
          </div>
        )}
      </div>
      <Content />
    </article>
  </Markdown>
</Base>
